# Version control
.git

# Python (** needed to match nested dirs)
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.Python
**/*.py[cod]
*$py.class
.pytest_cache
.coverage
.coveragerc

# Orbit and native caches
.orbit
**/.orbit
**/.venv
**/.venv-mps
**/.uv-cache
**/.ruff_cache
**/.hypothesis

# Environment
# .env
.venv
env/
venv/
ENV/

# IDE
.idea
.vscode
*.swp
*.swo

